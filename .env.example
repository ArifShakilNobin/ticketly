# Copy to `.env` and adjust. Every value has a safe local default, so this file
# is optional for development.

# Shared HS256 signing key — MUST be at least 32 characters.
JWT_SECRET=ticketly-dev-secret-key-change-me-32-characters-min

# CORS origins allowed by the gateway (comma separated, or *)
CORS_ALLOWED_ORIGINS=*

# Voice NLP: "mock" (default, offline) or "openai" (real Whisper API)
VOICE_STT_PROVIDER=mock
OPENAI_API_KEY=

# Host-run services talk to Kafka on the EXTERNAL listener
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
